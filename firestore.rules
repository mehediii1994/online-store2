rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    function me(){ return get(/databases/$(d)/documents/shops/main/users/$(request.auth.uid)); }
    function isUser(){ return request.auth != null && exists(/databases/$(d)/documents/shops/main/users/$(request.auth.uid)); }
    function owner(){ return isUser() && me().data.role == 'owner'; }
    match /shops/main/meta/{m} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && m == 'init' && request.resource.data.owner == request.auth.uid;
    }
    match /shops/main/users/{u} {
      allow read: if request.auth != null && (request.auth.uid == u || owner());
      allow create: if request.auth != null && request.auth.uid == u && request.resource.data.role == 'owner'
                    && !exists(/databases/$(d)/documents/shops/main/meta/init);
      allow write: if owner();
    }
    // public shop: published products and shop settings are readable by anyone
    match /shops/main/pub/{p} {
      allow read: if true;
      allow update: if isUser() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock','t']);
    }
    match /shops/main/shopcfg/{c} { allow read: if true; }
    // customer orders: anyone can create a Cash-on-Delivery order; read one only by knowing its ID
    match /shops/main/orders/{o} {
      allow get: if true;
      allow create: if o.size() >= 10 && request.resource.data.id == o
        && request.resource.data.keys().hasOnly(['id','items','sub','ship','total','name','phone','addr','dist','area','email','note','pay','payStatus','status','created','hist'])
        && request.resource.data.status == 'pending' && request.resource.data.pay == 'cod' && request.resource.data.payStatus == 'unpaid'
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.addr is string && request.resource.data.addr.size() <= 300
        && request.resource.data.total is number && request.resource.data.total >= 0 && request.resource.data.total < 10000000;
    }
    match /shops/main/{s}/{id} {
      allow read: if isUser();
      allow write: if owner() || (isUser() && !(s in ['purchases','expenses','suppliers','settings','users','meta','pub','shopcfg']));
    }
  }
}
